NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://vista:vista@localhost:5432/vista
APP_ORIGIN=http://localhost:5173
AUTH_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# SMTP is required for email verification, invitations, and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Vista <no-reply@example.com>

# Stripe billing is enabled only when configured. Create recurring prices in Stripe
# and map your own price IDs; no price IDs or production credentials are included here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# Optional S3-compatible object storage for uploaded source files.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto
